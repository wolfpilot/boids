{
  "type": "module",
  "name": "boids",
  "description": "JS Canvas experiment with boids.",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "author": "Razvan Negrea <howl@wolfpilot.co> (www.wolfpilot.co)",
  "license": "MIT",
  "scripts": {
    "prepare": "husky install",
    "start": "parcel --port 3000 ./src/index.html",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cleanup": "rimraf .cache",
    "format": "prettier \"src/**/*.ts\" --write",
    "validate": "tsc --noEmit",
    "lint": "eslint -f stylish \"**/*.ts\"",
    "prebuild": "rimraf dist",
    "build:parcel": "parcel build ./src/index.html --no-source-maps --public-url ./",
    "build": "pnpm validate && pnpm cleanup && pnpm build:parcel",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@datorama/akita": "^6.2.4",
    "autoprefixer": "^9.8.8",
    "dat.gui": "^0.7.9",
    "postcss": "^8.5.30",
    "postcss-modules": "^3.2.2",
    "rxjs": "^6.6.7",
    "ts-node": "^9.1.1"
  },
  "devDependencies": {
    "@jest/types": "^30.5.1",
    "@types/dat.gui": "^0.7.13",
    "@types/jest": "^26.0.24",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-jest": "^24.7.0",
    "eslint-plugin-prettier": "^3.4.1",
    "gh-pages": "^6.3.0",
    "husky": "^6.0.0",
    "jest": "^26.6.3",
    "jest-canvas-mock": "^2.5.8",
    "parcel-bundler": "^1.12.5",
    "prettier": "^2.8.8",
    "rimraf": "^6.1.3",
    "ts-jest": "^26.5.6",
    "typescript": "^4.9.5"
  }
}
