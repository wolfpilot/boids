{
  "type": "module",
  "name": "boids",
  "description": "JS Canvas experiment with boids.",
  "version": "0.0.0",
  "private": true,
  "author": "Razvan Negrea <howl@wolfpilot.co> (www.wolfpilot.co)",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "start": "parcel --port 3000 ./src/index.html",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cleanup": "rimraf .parcel-cache",
    "format": "prettier \"src/**/*.ts\" --write",
    "validate": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "prebuild": "rimraf dist",
    "build:parcel": "parcel build ./src/index.html --no-source-maps --public-url ./",
    "build": "pnpm validate && pnpm cleanup && pnpm build:parcel",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@datorama/akita": "^8.0.1",
    "dat.gui": "^0.7.9",
    "rxjs": "^7.8.2",
    "tslib": "2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dat.gui": "^0.7.13",
    "@types/jest": "^30.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.2",
    "parcel": "^2.16.4",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
